<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="rootPane" stylesheets="@/resources/css/home-page.css" xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml" fx:controller="app.controller.HomePageController">
    <top>
        <VBox alignment="TOP_CENTER" styleClass="top-bar">
            <VBox fx:id="headerContainerVBox" spacing="16.0" maxWidth="1440.0">
                <padding>
                    <Insets top="18.0" right="24.0" bottom="18.0" left="24.0" />
                </padding>

                <HBox fx:id="headerTopHBox" spacing="40.0" alignment="CENTER">
                    <Label styleClass="brand-title" text="%nav.brand" style="-fx-font-size: 24px; -fx-text-fill: -color-accent-emphasis;"/>
                    
                    <HBox fx:id="searchWrapBox" spacing="12.0" styleClass="search-wrap" HBox.hgrow="ALWAYS" maxWidth="600" alignment="CENTER_LEFT">
                        <Label text="🔍" style="-fx-opacity: 0.5;"/>
                        <TextField fx:id="searchField" promptText="%home.search.prompt"
                            HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;"/>
                    </HBox>

                    <HBox fx:id="navButtonsBox" spacing="16.0" alignment="CENTER_RIGHT">
                        <HBox fx:id="notificationNavBox" alignment="CENTER_LEFT" spacing="6.0" visible="false" managed="false">
                            <Button styleClass="nav-ghost" text="🔔" />
                            <Label fx:id="notificationBadgeLabel" styleClass="watchlist-badge" text="0" style="-fx-background-color: -color-danger-emphasis; -fx-text-fill: white;"
                                visible="false" managed="false" />
                        </HBox>
                        
                        <HBox fx:id="watchlistNavBox" alignment="CENTER_LEFT" spacing="6.0">
                            <Button styleClass="nav-ghost" text="%nav.watchlist" onAction="#onOpenWatchlist" />
                            <Label fx:id="watchlistBadgeLabel" styleClass="watchlist-badge" text="0"
                                visible="false" managed="false" />
                        </HBox>
                        
                        <HBox spacing="8.0" alignment="CENTER_RIGHT">
                            <Button fx:id="sellerItemsButton" styleClass="nav-ghost" text="%nav.sellerItems"
                                onAction="#onOpenSellerItems" visible="false" managed="false" />
                            <Button fx:id="adminDashboardButton" styleClass="nav-ghost" text="%nav.admin"
                                onAction="#onOpenAdminDashboard" visible="false" managed="false" />
                            <Button fx:id="profileButton" styleClass="nav-ghost" text="%nav.profile"
                                onAction="#onOpenProfile" visible="false" managed="false" />
                            <Button fx:id="logoutButton" styleClass="nav-ghost" text="%nav.logout"
                                onAction="#onLogout" visible="false" managed="false" />
                            <Button styleClass="nav-ghost" text="☼/☾" onAction="#onToggleTheme" />
                            <Button fx:id="signInButton" styleClass="primary-button" text="%nav.signIn"
                                onAction="#onOpenSignIn"/>
                        </HBox>
                    </HBox>
                </HBox>
            <FlowPane fx:id="categoryBar" hgap="8.0" vgap="8.0" />
            </VBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox alignment="TOP_CENTER" styleClass="page-root-inner">
                    <VBox spacing="32.0" maxWidth="1400" alignment="TOP_CENTER" style="-fx-background-color: -color-bg-default; -fx-background-radius: 30 30 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 30, 0, 0, -20);">
                        <padding>
                            <Insets top="48.0" right="60.0" bottom="60.0" left="60.0" />
                        </padding>

                        <VBox spacing="16.0" alignment="CENTER" styleClass="hero-section">
                            <padding>
                                <Insets top="60.0" right="40.0" bottom="60.0" left="40.0" />
                            </padding>
                            <Label fx:id="pageTitleLabel" styleClass="page-title" text="Discover Treasures" />
                            <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle" text="Find the best items from around the world." alignment="CENTER" textAlignment="CENTER"/>
                        </VBox>

                        <VBox fx:id="roleDashboardBox" spacing="16.0" alignment="CENTER_LEFT" styleClass="role-dashboard-container">
                            <Label fx:id="roleDashboardTitle" styleClass="role-dashboard-title" text="Dashboard" />
                            <Label fx:id="roleDashboardSubtitle" styleClass="role-dashboard-subtitle" text="Welcome back!" wrapText="true" />
                            <Label fx:id="sellerDashboardItemsLabel" visible="false" managed="false" />
                            <Button fx:id="roleDashboardActionButton" styleClass="primary-button" text="Action" onAction="#onRoleDashboardAction" />
                        </VBox>

                        <VBox spacing="24.0">
                            <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                                <VBox HBox.hgrow="ALWAYS">
                                    <Label fx:id="sectionTitleLabel" styleClass="section-title" text="Featured Auctions" />
                                    <Label fx:id="resultLabel" styleClass="result-label" text="0 items found" />
                                </VBox>
                                <Button styleClass="nav-ghost" text="Filter &amp; Sort ▾" onAction="#onShowFilterMenu" />
                            </HBox>

                            <StackPane>
                                <FlowPane fx:id="auctionGrid" hgap="24.0" vgap="32.0" alignment="TOP_CENTER" />
                                <Label fx:id="emptyStateLabel" styleClass="empty-state-label" text="No auctions found."
                                    visible="false" managed="false" />
                            </StackPane>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="TOP_CENTER" styleClass="footer">
            <VBox spacing="0.0" maxWidth="1440.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="12.0" right="24.0" bottom="12.0" left="24.0" />
                </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="footer-bottom" style="-fx-border-width: 0;">
                <Label text="%footer.brand" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="nav-ghost" text="%nav.langToggle" onAction="#onToggleLang" />
                <Button styleClass="nav-ghost" text="☼/☾ Theme" onAction="#onToggleTheme" />
                <Label text="%footer.copyright" />
            </HBox>
            </VBox>
        </VBox>
    </bottom>
</BorderPane>