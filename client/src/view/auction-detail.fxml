<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.AuctionDetailController">
    <stylesheets>
        <URL value="@../resources/css/home-page.css" />
        <URL value="@../resources/css/auction-detail.css" />
    </stylesheets>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
            <padding>
                <Insets top="16.0" right="24.0" bottom="10.0" left="24.0" />
            </padding>
            <Button styleClass="secondary-button" text="%nav.back" onAction="#onBackToHome" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="32.0" alignment="TOP_CENTER" styleClass="detail-root-inner">
                    <padding>
                        <Insets top="40.0" right="60.0" bottom="60.0" left="60.0" />
                    </padding>

                    <HBox spacing="48.0" alignment="TOP_CENTER" maxWidth="1400">
                        <!-- Left Column (Product Details & History) -->
                        <VBox spacing="32.0" prefWidth="750" HBox.hgrow="ALWAYS">
                            <!-- Image Container -->
                            <StackPane styleClass="detail-image-container">
                                <ImageView fx:id="itemImageView" fitWidth="700.0" fitHeight="500.0" pickOnBounds="true"
                                    preserveRatio="true" styleClass="detail-image" />
                                <Label fx:id="statusBadge" styleClass="detail-status-badge" StackPane.alignment="TOP_RIGHT">
                                    <StackPane.margin><Insets top="20" right="20"/></StackPane.margin>
                                </Label>
                            </StackPane>

                            <!-- About the Item (Description & Tech Specs in 2-Column GridPane) -->
                            <VBox spacing="20.0" styleClass="glass-card">
                                <Label styleClass="section-title" text="About this Item" />
                                <Label fx:id="descriptionLabel" styleClass="detail-description" text="Description" wrapText="true" />
                                
                                <GridPane hgap="32.0" vgap="14.0" style="-fx-padding: 20 0 0 0; -fx-border-color: -color-border-subtle; -fx-border-width: 1 0 0 0;">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50" />
                                        <ColumnConstraints percentWidth="50" />
                                    </columnConstraints>
                                    
                                    <!-- Row 0 -->
                                    <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0" alignment="CENTER_LEFT">
                                        <Label text="Auction ID:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="auctionIdLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER_LEFT">
                                        <Label text="Category:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="categoryDetailLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    
                                    <!-- Row 1 -->
                                    <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER_LEFT">
                                        <Label text="Seller:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="sellerLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="CENTER_LEFT">
                                        <Label text="Status:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="statusLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    
                                    <!-- Row 2 -->
                                    <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2" alignment="CENTER_LEFT">
                                        <Label text="Starting Bid:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="startingBidDetailLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2" alignment="CENTER_LEFT">
                                        <Label text="Current Price:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="currentPriceDetailLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    
                                    <!-- Row 3 -->
                                    <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3" alignment="CENTER_LEFT">
                                        <Label text="Start Time:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="startTimeDetailLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3" alignment="CENTER_LEFT">
                                        <Label text="End Time:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="endTimeDetailLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    
                                    <!-- Row 4 -->
                                    <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="4" alignment="CENTER_LEFT">
                                        <Label text="Total Bids:" styleClass="bid-label-small" prefWidth="120" />
                                        <Label fx:id="totalBidsDetailLabel" text="-" styleClass="wallet-val" />
                                    </HBox>
                                    <StackPane GridPane.columnIndex="1" GridPane.rowIndex="4">
                                        <HBox spacing="10" fx:id="highestBidderRow" alignment="CENTER_LEFT">
                                            <Label fx:id="highestBidderTitleLabel" text="Highest Bidder:" styleClass="bid-label-small" prefWidth="120" />
                                            <Label fx:id="highestBidderValueLabel" text="-" styleClass="wallet-val" />
                                        </HBox>
                                        <HBox spacing="10" fx:id="winnerRow" alignment="CENTER_LEFT">
                                            <Label text="Winner:" styleClass="bid-label-small" prefWidth="120" style="-fx-text-fill: -color-success-emphasis; -fx-font-weight: bold;" />
                                            <Label fx:id="winnerValueLabel" text="-" styleClass="wallet-val" style="-fx-text-fill: -color-success-emphasis; -fx-font-weight: bold;" />
                                        </HBox>
                                    </StackPane>
                                </GridPane>
                            </VBox>

                            <!-- Price History Chart -->
                            <VBox spacing="16.0" styleClass="glass-card">
                                <Label styleClass="section-title" text="Price History" />
                                <LineChart fx:id="bidChart" prefHeight="300.0" animated="false" legendVisible="false">
                                    <xAxis><CategoryAxis label="Bidder" tickLabelRotation="-40" /></xAxis>
                                    <yAxis><NumberAxis label="Amount" /></yAxis>
                                </LineChart>
                            </VBox>
                        </VBox>

                        <!-- Right Column (Title & Bidding Panel) -->
                        <VBox spacing="24.0" prefWidth="450" maxWidth="450">
                            <!-- Item Title and Category Card -->
                            <VBox spacing="12.0" styleClass="glass-card">
                                <Label fx:id="titleLabel" styleClass="detail-category" text="CATEGORY" />
                                <Label fx:id="itemNameLabel" styleClass="detail-item-name" text="Item Name" wrapText="true" />
                            </VBox>

                            <!-- Final Results Card (Hidden when Active) -->
                            <VBox fx:id="finalResultContainer" spacing="16.0" styleClass="glass-card" style="-fx-background-color: -color-bg-subtle; -fx-border-color: -color-success-emphasis; -fx-border-width: 2;">
                                <Label text="AUCTION ENDED" styleClass="bid-label-small" style="-fx-text-fill: -color-fg-muted;" />
                                <VBox spacing="4.0">
                                    <Label text="FINAL PRICE" styleClass="bid-label-small" />
                                    <Label fx:id="finalPriceLabel" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: -color-success-emphasis;" text="\$0.00" />
                                </VBox>
                                <HBox spacing="10" alignment="CENTER_LEFT" fx:id="finalWinnerRow">
                                    <Label text="WINNER:" styleClass="bid-label-small" />
                                    <Label fx:id="finalWinnerLabel" text="No Winner" style="-fx-font-weight: bold; -fx-text-fill: -color-fg-default; -fx-font-size: 16px;" />
                                </HBox>
                                <Label fx:id="finalStatusLabel" styleClass="card-badge" text="FINISHED" style="-fx-background-color: -color-success-emphasis; -fx-text-fill: -color-fg-emphasis;" />
                            </VBox>

                            <!-- Active Bidding Card (Hidden when Ended) -->
                            <VBox fx:id="biddingContainer" spacing="24.0" styleClass="bidding-card">
                                <VBox spacing="4.0">
                                    <Label text="CURRENT PRICE" styleClass="bid-label-small" />
                                    <Label fx:id="currentBidLabel" styleClass="detail-current-price" text="0.00" />
                                    <HBox spacing="10">
                                        <Label text="Starting from:" styleClass="wallet-label" />
                                        <Label fx:id="startingBidLabel" text="0.00" styleClass="bid-label-small" />
                                    </HBox>
                                </VBox>

                                <VBox spacing="12.0">
                                    <Label text="TIME REMAINING" styleClass="bid-label-small" />
                                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                                        <VBox alignment="CENTER" styleClass="time-unit-box">
                                            <Label fx:id="daysValueLabel" text="00" styleClass="time-unit-val" />
                                            <Label text="days" styleClass="time-unit-label" />
                                        </VBox>
                                        <VBox alignment="CENTER" styleClass="time-unit-box">
                                            <Label fx:id="hoursValueLabel" text="00" styleClass="time-unit-val" />
                                            <Label text="hours" styleClass="time-unit-label" />
                                        </VBox>
                                        <VBox alignment="CENTER" styleClass="time-unit-box">
                                            <Label fx:id="minsValueLabel" text="00" styleClass="time-unit-val" />
                                            <Label text="mins" styleClass="time-unit-label" />
                                        </VBox>
                                        <VBox alignment="CENTER" styleClass="time-unit-box">
                                            <Label fx:id="secsValueLabel" text="00" styleClass="time-unit-val" style="-fx-text-fill: -color-danger-emphasis;" />
                                            <Label text="secs" styleClass="time-unit-label" />
                                        </VBox>
                                    </HBox>
                                    <Label fx:id="timeLeftLabel" visible="false" managed="false"/>
                                </VBox>

                                <VBox spacing="16.0">
                                    <VBox spacing="8.0">
                                        <TextField fx:id="bidAmountField" promptText="Enter amount" styleClass="bid-field" />
                                        <Label fx:id="minimumBidLabel" styleClass="bid-label-small" text="Min bid: 0.00" />
                                    </VBox>
                                    <Button fx:id="placeBidButton" maxWidth="Infinity" styleClass="place-bid-btn" text="Place Bid Now" onAction="#onPlaceBid" />
                                    <Label fx:id="bidMessageLabel" style="-fx-text-fill: -color-accent-emphasis; -fx-font-size: 13px;" text="" />
                                    <Label fx:id="extendedBadgeLabel" visible="false" managed="false" />
                                </VBox>
                            </VBox>

                            <!-- Auto-Bid Card (Hidden when Ended) -->
                            <VBox fx:id="autoBidContainer" spacing="16.0" styleClass="glass-card" style="-fx-padding: 24;">
                                <Label text="Auto-Bidding" styleClass="wallet-title" />
                                <HBox spacing="10">
                                    <TextField fx:id="autoBidMaxField" promptText="Max bid" HBox.hgrow="ALWAYS" styleClass="bid-field" />
                                    <TextField fx:id="autoBidIncrementField" promptText="Step" prefWidth="80" styleClass="bid-field" />
                                </HBox>
                                <Button fx:id="enableAutoBidButton" maxWidth="Infinity" text="Enable Auto-Bid" styleClass="secondary-button" onAction="#onEnableAutoBid" />
                            </VBox>

                            <!-- Recent Activity Card -->
                            <VBox spacing="16.0" styleClass="glass-card" VBox.vgrow="ALWAYS">
                                <Label text="Recent Activity" styleClass="section-title" />
                                <ListView fx:id="bidHistoryList" prefHeight="250.0" styleClass="bid-history-list" />
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
