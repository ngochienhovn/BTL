<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml" fx:controller="app.controller.AdminDashboardController">
    <stylesheets>
        <URL value="@/resources/css/home-page.css" />
        <URL value="@/resources/css/dashboards.css" />
    </stylesheets>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
            <padding>
                <Insets top="16.0" right="40.0" bottom="16.0" left="40.0" />
            </padding>
            <Button styleClass="secondary-button" text="%nav.back" onAction="#onBackHome" />
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT">
                <Label styleClass="brand-title" text="%admin.title" />
                <Label styleClass="item-row-meta" text="System Control Panel" />
            </VBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="32.0" styleClass="page-root-inner">
                    <padding>
                        <Insets top="32.0" right="40.0" bottom="40.0" left="40.0" />
                    </padding>

                    <HBox spacing="24.0">
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                            <VBox spacing="16.0">
                                <HBox spacing="20.0" styleClass="stats-container">
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="TOTAL USERS" />
                                        <Label fx:id="totalUsersLabel" styleClass="stat-value" text="0" />
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="TOTAL AUCTIONS" />
                                        <Label fx:id="totalAuctionsLabel" styleClass="stat-value" text="0" />
                                    </VBox>
                                </HBox>
                                <HBox spacing="15.0" styleClass="stats-container">
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="OPEN" />
                                        <Label fx:id="openCountLabel" styleClass="stat-value" text="0" style="-fx-text-fill: -color-fg-muted;" />
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="RUNNING" />
                                        <Label fx:id="runningCountLabel" styleClass="stat-value" text="0" style="-fx-text-fill: -color-success-emphasis;" />
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="FINISHED" />
                                        <Label fx:id="finishedCountLabel" styleClass="stat-value" text="0" style="-fx-text-fill: -color-accent-fg;" />
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="CANCELED" />
                                        <Label fx:id="canceledCountLabel" styleClass="stat-value" text="0" style="-fx-text-fill: -color-danger-emphasis;" />
                                    </VBox>
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <Label styleClass="stat-label" text="PAID" />
                                        <Label fx:id="paidCountLabel" styleClass="stat-value" text="0" style="-fx-text-fill: -color-accent-emphasis;" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            
                            <VBox styleClass="form-card">
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label styleClass="form-header" text="Auction Management" HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="confirmPaymentBtn" styleClass="primary-button" text="Confirm Payment" onAction="#onConfirmPayment" />
                                    <Button styleClass="success-button" text="Export CSV" onAction="#onExportAuctions" style="-fx-background-color: #2ea043; -fx-text-fill: white;" />
                                    <Button styleClass="secondary-button" text="Edit Selected" onAction="#onEditAuction" />
                                    <Button styleClass="warning-button" text="Cancel Auction" onAction="#onCancelAuction" />
                                    <Button styleClass="danger-button" text="Delete Auction" onAction="#onDeleteAuction" />
                                </HBox>
                                <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 10 0;">
                                    <TextField fx:id="auctionSearchField" promptText="Search Auctions..." HBox.hgrow="ALWAYS" />
                                    <ComboBox fx:id="auctionStatusFilterCombo" promptText="Filter Status" prefWidth="150.0" />
                                </HBox>
                                <ListView fx:id="auctionListView" prefHeight="250.0" styleClass="modern-list-view" />
                            </VBox>
                        </VBox>
                        
                        <VBox styleClass="form-card" prefWidth="400.0">
                            <Label styleClass="form-header" text="Category Distribution" />
                            <javafx.scene.chart.PieChart fx:id="categoryChart" prefHeight="300.0" labelsVisible="true" />
                        </VBox>
                    </HBox>

                    <HBox spacing="24.0">
                        <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-header" text="User Management" />
                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                                <TextField fx:id="userNameField" promptText="%admin.prompt.userName" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="userPasswordField" promptText="%admin.prompt.password" HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="userRoleCombo" prefWidth="120.0" />
                                <Button styleClass="secondary-button" text="%admin.updateUser" onAction="#onUpdateSelectedUser" />
                                <Button styleClass="danger-button" text="%admin.deleteUser" onAction="#onDeleteSelectedUser" />
                            </HBox>
                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                                <TextField fx:id="userSearchField" promptText="Search Users (Name/Email)..." HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="userRoleFilterCombo" promptText="Filter Role" prefWidth="120.0" />
                            </HBox>
                            <ListView fx:id="userListView" prefHeight="300.0" styleClass="modern-list-view" />
                        </VBox>
                        
                        <VBox styleClass="form-card" prefWidth="450.0">
                            <Label styleClass="form-header" text="Recent Bid Activity" />
                            <ListView fx:id="bidLogListView" prefHeight="350.0" styleClass="modern-list-view" />
                        </VBox>
                    </HBox>

                    <HBox spacing="24.0">
                        <VBox styleClass="form-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-header" text="Item Management" />
                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                                <TextField fx:id="itemNameField" promptText="Item Name" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="itemDescriptionField" promptText="Description" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="itemBidField" promptText="Starting Bid" prefWidth="100.0" />
                                <Button styleClass="secondary-button" text="Update Item" onAction="#onUpdateSelectedItem" />
                                <Button styleClass="danger-button" text="Delete Item" onAction="#onDeleteSelectedItem" />
                            </HBox>
                            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                                <TextField fx:id="itemSearchField" promptText="Search Items (Name/Desc)..." HBox.hgrow="ALWAYS" />
                            </HBox>
                            <ListView fx:id="itemListView" prefHeight="250.0" styleClass="modern-list-view" />
                        </VBox>
                    </HBox>

                    <Label fx:id="adminMessageLabel" styleClass="result-label" text="" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
